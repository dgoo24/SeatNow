# ------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores reales.
# Este .env es consumido por docker-compose y por el backend.
# ------------------------------------------------------------------

# --- Infra (docker-compose) ---
POSTGRES_USER=mvp
POSTGRES_PASSWORD=mvp_secret
POSTGRES_DB=mvp_trenes
# Puerto del host -> contenedor. Se usa 5433 por defecto para no chocar con un
# PostgreSQL local ya instalado en Windows (que ocupa el 5432). Cambialo si lo necesitas.
POSTGRES_PORT=5433
REDIS_PORT=6379

# --- Backend HTTP ---
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:19006

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://mvp:mvp_secret@localhost:5433/mvp_trenes?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
SEAT_HOLD_TTL_SECONDS=300

# --- No-Show / Comfort Check-In ---
NO_SHOW_GRACE_MINUTES=15
NO_SHOW_SWEEP_MS=60000

# --- Disrupciones ---
CRITICAL_DELAY_MINUTES=60

# --- Stripe ---
# Deja STRIPE_SECRET_KEY vacío para usar el modo MOCK (no requiere cuenta Stripe).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- SMTP / Nodemailer ---
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Trenes MVP <no-reply@trenes-mvp.local>"

# --- GTFS ---
# Ruta local a un .zip GTFS o a una carpeta con stops.txt/routes.txt/trips.txt/stop_times.txt
GTFS_SOURCE=./gtfs-data
# Opcional: URL pública de un zip GTFS. Si se define, tiene prioridad sobre GTFS_SOURCE.
GTFS_URL=

# --- Deutsche Bahn Timetables API (app Streamlit) ---
# Credenciales de https://developer.db.de/ (API "Timetables"). Sin ellas la app
# funciona con el feed GTFS de demostración; con ellas usa horarios reales.
DB_CLIENT_ID=
DB_API_KEY=
# URL base de la API (solo para pruebas o mirrors).
SEATNOW_DB_API_URL=https://apis.deutschebahn.com/db-api-marketplace/apis/timetables/v1
# Zona horaria de los horarios (la DB usa la hora local alemana).
SEATNOW_TIMEZONE=Europe/Berlin

# --- Uploads (boletos reales subidos por el Concierge) ---
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000
