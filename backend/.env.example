# Backend environment. Copia a backend/.env
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:19006

DATABASE_URL=postgresql://mvp:mvp_secret@localhost:5433/mvp_trenes?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
SEAT_HOLD_TTL_SECONDS=300

# --- No-Show / Comfort Check-In ---
# Minutos tras la salida de origen sin check-in en los que se libera el asiento.
NO_SHOW_GRACE_MINUTES=15
# Cadencia del barrido periodico de No-Show (ms).
NO_SHOW_SWEEP_MS=60000

# --- Disrupciones ---
# Retraso critico (min) que dispara la notificacion proactiva al pasajero.
CRITICAL_DELAY_MINUTES=60

# Deja la secret vacia para usar el modo MOCK de pagos.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Trenes MVP <no-reply@trenes-mvp.local>"

GTFS_SOURCE=./gtfs-data
GTFS_URL=

UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:3000
