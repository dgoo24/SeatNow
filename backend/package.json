{
  "name": "trenes-mvp-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Fastify + TypeScript (monolito modular) para reserva de billetes de tren.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -r ts-node/register/transpile-only --test src/modules/inventory/inventory.test.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "gtfs:ingest": "ts-node --transpile-only src/modules/trains/ingest-gtfs.ts",
    "seed:admin": "ts-node --transpile-only src/scripts/seed-admin.ts",
    "demo:occupancy": "ts-node --transpile-only src/scripts/seed-occupancy.ts",
    "demo:passengers": "ts-node --transpile-only src/scripts/demo-passengers.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "stripe": "^16.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.16.11",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.5",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
